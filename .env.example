# ---------------------------------------------------------------------------
# DevOffice AI - M0 (Planning Lab) environment
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Provider credentials (SERVER-SIDE ONLY) -------------------------------
# Get one at https://console.groq.com/keys
GROQ_API_KEY=replace_me

# Leave EMPTY until you have run `npm run models`.
# No default is shipped on purpose: which models an account can reach differs
# per account and changes over time. As of 24 Nov 2026 the self-serve text
# models were openai/gpt-oss-120b and openai/gpt-oss-20b, while the Llama
# production models had moved to Enterprise (Contact Sales) - so a hardcoded
# default would be a promise this project cannot keep. Verify, then set.
GROQ_MODEL_PLANNING=

GROQ_BASE_URL=https://api.groq.com/openai/v1

# json_schema = strict mode (documented for gpt-oss-20b/120b, qwen3.8-27b).
# json_object = best-effort JSON, for a model without strict support.
GROQ_STRUCTURED_MODE=json_schema

# --- Pacing -----------------------------------------------------------------
# A SELF-IMPOSED ceiling, not a claim about your quota. Set it at or below
# what your account's limits page shows. Whatever the provider reports in its
# response headers always overrides these numbers at runtime.
#
# Why the token ceiling is the one that matters: one planning call can be
# 2,000-3,000 tokens, so the binding limit is tokens per minute, not requests.
# Reported free-tier figures vary between 6,000 and 8,000 tokens/min depending
# on model and on when the source was written, so 5,000 is set deliberately
# BELOW the lowest figure seen. Raise it only after reading your own limits
# page in the Groq console. Note also that limits apply per ORGANISATION, not
# per API key - making extra keys does not give you more quota.
WORKER_MAX_CONCURRENCY=1
THROTTLE_MAX_REQUESTS_PER_MINUTE=25
THROTTLE_MAX_TOKENS_PER_MINUTE=5000
THROTTLE_MIN_INTERVAL_MS=0

# A 429 asking us to wait longer than this is treated as a daily-quota wall:
# the run stops as BLOCKED (resumable) instead of looping for hours.
QUOTA_EXHAUSTED_THRESHOLD_MS=300000

# --- Retries and limits -----------------------------------------------------
MODEL_REQUEST_MAX_RETRIES=2
SCHEMA_REPAIR_MAX_RETRIES=2
MEETING_MAX_ROUNDS=3
MODEL_MAX_OUTPUT_TOKENS=2048
# Groq converts a temperature of 0 to 1e-8; keep this above 0.
MODEL_TEMPERATURE=0.3
REQUEST_TIMEOUT_MS=90000

# --- Phase gate -------------------------------------------------------------
# MUST stay false for M0-M3. Setting it true makes the app refuse to start:
# autonomous coding needs a sandbox, a coding-engine adapter and a separate
# Product Owner approval (HLD 12, LLD 2.2).
ENABLE_AUTONOMOUS_BUILD=false

# --- Local paths ------------------------------------------------------------
RUNS_DIR=./runs
LOG_LEVEL=info

# --- Not used at M0 ---------------------------------------------------------
# Supabase arrives at M1 (LLD 1.1). Left here so the shape is visible, but
# nothing reads these yet. Use the key names your chosen Supabase SDK
# version actually supports, and keep the service-role key server-side.
# NEXT_PUBLIC_SUPABASE_URL=replace_me
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
# SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only
